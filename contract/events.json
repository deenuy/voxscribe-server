    "Envelope": {
      "additionalProperties": false,
      "description": "One event on the event stream.\n\nid         opaque. Unique and ordered within the subscriber's stream (one stream per tenant,\n           or one shared stream with isolation off). A client sends the last one it received\n           back as Last-Event-ID when it reconnects; it must not parse it\nsessionId  the voice session that published the event, when one did\nseq        that session's sequence number: 1 for its first event, one more for each after,\n           with no gap. Absent on events no session published",
      "properties": {
        "data": {
          "title": "Data"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "seq": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seq"
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "title": "Envelope",
      "type": "object"
    },
