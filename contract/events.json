          "title": "Id",
          "type": "string"
        },
        "startMs": {
          "title": "Startms",
          "type": "integer"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "state",
        "startMs",
        "endMs"
      ],
      "title": "WakeSegment",
      "type": "object"
    },
    "WakeStatePayload": {
      "additionalProperties": true,
      "description": "The device's wake state. A fact about a device, not a session: it goes to the tenant the\ndevice is bound to (see events.py, \"Who receives what\").",
      "properties": {
        "meeting_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meeting Id"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "phrase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phrase"
        },
        "state": {
          "enum": [
            "off",
            "armed",
            "listening",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
