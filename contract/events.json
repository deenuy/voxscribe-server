          "title": "Meetingid",
          "type": "string"
        },
        "phase": {
          "enum": [
            "thinking",
            "done"
          ],
          "title": "Phase",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "turn": {
          "title": "Turn",
          "type": "integer"
        },
        "userText": {
          "title": "Usertext",
          "type": "string"
        }
      },
      "required": [
